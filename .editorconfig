root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.{csproj,props,sln}]
end_of_line = crlf

[*.ps1]
charset = utf-8-bom
indent_size = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# Las migraciones de Entity Framework son archivos generados: no llevan documentación XML.
[**/Migraciones/*.cs]
generated_code = true
dotnet_diagnostic.CS1591.severity = none
